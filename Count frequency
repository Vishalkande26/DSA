class Main{
    public static void main(String args[]){
        String s1 = "Vishal";
        
        for(int i = 0; i < s1.length(); i++){
            
            if(s1.indexOf(s1.charAt(i)) != i)
               continue;
               
            int count = 1;
            
            for(int j = i + 1; j < s1.length(); j++){
                if(s1.charAt(i) == s1.charAt(j)){
                    count++;
                }
            }
            System.out.println(s1.charAt(i)+ "=" + count);
        }
    }
}
