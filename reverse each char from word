class Main{
    public static void main(String args[]){
        String s1 = "I am java developer";
        String s2[] = s1.split(" ");
        
        for(String word : s2){
            for(int i = word.length()-1; i>=0; i--){
                System.out.print(word.charAt(i));
            }
            System.out.print(" ");
        }
    }
}
