class Main {
    public static void main(String[] args) {
       String s1 = "Hi i am a java developer";
       int count = 0;
       
       for(int i = 0; i < s1.length(); i++){
           char ch = s1.charAt(i);
           
           
           if((ch >= 'A' && ch <= 'Z') || (ch >= 'a' && ch <= 'z')){
               
           
             if(ch != 'A' && ch != 'a' &&
               ch != 'E' && ch != 'e' &&
               ch != 'I' && ch != 'i' &&
               ch != 'O' && ch != 'o' &&
               ch != 'U' && ch != 'u'){
                   
                   count++;
                  
               }
            }
       }
       System.out.println(count);
    }
}
